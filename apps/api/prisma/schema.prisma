generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  PLAYER
  GM
}

model Account {
  id               String                   @id @default(uuid()) @db.Uuid
  login            String
  loginKey         String                   @unique
  passwordHash     String
  role             AccountRole              @default(PLAYER)
  sessionVersion   Int                      @default(0)
  access           CharacterAccess[]
  tokenStatusViews ArenaTokenStatusViewer[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@map("accounts")
}

model Character {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  folderId      String?           @db.Uuid
  folder        CharacterFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  position      Int               @default(0)
  access        CharacterAccess[]
  avatarKey     String?
  artKey        String?
  figureKey     String?
  tokenStyle    String            @default("portrait")
  showTokenName Boolean           @default(false)
  features      String[]          @default([])
  markedShare   MarkedShare?
  arenaTokens   ArenaToken[]
  sheet         Json              @default("{}")
  sheetVersion  Int               @default(0)
  legacy        Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("characters")
}

model CharacterFolder {
  id         String            @id @default(uuid()) @db.Uuid
  name       String
  parentId   String?           @db.Uuid
  parent     CharacterFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   CharacterFolder[] @relation("FolderTree")
  characters Character[]
  position   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([parentId])
  @@map("character_folders")
}

model CharacterAccess {
  characterId String    @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  accountId   String    @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([characterId, accountId])
  @@index([accountId])
  @@map("character_access")
}

model MarkedShare {
  id                String    @id @default(uuid()) @db.Uuid
  singleton         Boolean   @unique @default(true)
  sourceCharacterId String    @unique @db.Uuid
  source            Character @relation(fields: [sourceCharacterId], references: [id], onDelete: Cascade)
  traitName         String
  traitDescription  String
  startedAt         DateTime  @default(now())

  @@map("marked_shares")
}

model ArenaSceneFolder {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?            @db.Uuid
  parent    ArenaSceneFolder?  @relation("SceneFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ArenaSceneFolder[] @relation("SceneFolderTree")
  scenes    ArenaScene[]
  position  Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([parentId])
  @@map("arena_scene_folders")
}

model ArenaScene {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  folderId    String?           @db.Uuid
  folder      ArenaSceneFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  mapKey      String?
  mapWidth    Int?
  mapHeight   Int?
  boardWidth  Float?
  boardHeight Float?
  position    Int               @default(0)
  tokens      ArenaToken[]
  activeState ArenaState?
  turnEntries ArenaTurnEntry[]
  /// Round of the turn order of the scene (starts at 1, grows when the order wraps).
  turnRound   Int               @default(1)
  /// Token whose turn it is (null: nobody).
  turnTokenId String?           @unique @db.Uuid
  turnToken   ArenaToken?       @relation("SceneTurnToken", fields: [turnTokenId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([folderId])
  @@map("arena_scenes")
}

model ArenaToken {
  id              String                   @id @default(uuid()) @db.Uuid
  sceneId         String                   @db.Uuid
  scene           ArenaScene               @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId     String?                  @db.Uuid
  character       Character?               @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name            String?
  imageKey        String?
  tokenStyle      String                   @default("portrait")
  showName        Boolean                  @default(true)
  x               Float                    @default(0)
  y               Float                    @default(0)
  size            Int                      @default(140)
  hidden          Boolean                  @default(false)
  position        Int                      @default(0)
  healthCurrent   Int?
  healthMax       Int?
  sanityCurrent   Int?
  sanityMax       Int?
  statusPublic    Boolean                  @default(false)
  statusViewers   ArenaTokenStatusViewer[]
  /// Bonus added to 1d20 when the token rolls initiative from its menu (NPC tokens).
  initiativeBonus Int                      @default(0)
  turnEntry       ArenaTurnEntry?
  turnOf          ArenaScene?              @relation("SceneTurnToken")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([sceneId])
  @@index([characterId])
  @@map("arena_tokens")
}

model ArenaTurnEntry {
  id         String     @id @default(uuid()) @db.Uuid
  sceneId    String     @db.Uuid
  scene      ArenaScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  tokenId    String     @unique @db.Uuid
  token      ArenaToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  initiative Int?
  position   Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([sceneId])
  @@map("arena_turn_entries")
}

model ArenaTokenStatusViewer {
  tokenId   String     @db.Uuid
  token     ArenaToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  accountId String     @db.Uuid
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([tokenId, accountId])
  @@index([accountId])
  @@map("arena_token_status_viewers")
}

model ArenaState {
  id            String      @id @default(uuid()) @db.Uuid
  singleton     Boolean     @unique @default(true)
  activeSceneId String?     @unique @db.Uuid
  activeScene   ArenaScene? @relation(fields: [activeSceneId], references: [id], onDelete: SetNull)
  worldMapLive  Boolean     @default(false)
  partyX        Float       @default(1000)
  partyY        Float       @default(728.5)
  fogMask       Bytes?
  fogVersion    Int         @default(0)
  updatedAt     DateTime    @updatedAt

  @@map("arena_state")
}

model MediaAsset {
  id          String   @id @db.Uuid
  hash        String   @unique
  key         String   @unique
  thumbKey    String?
  width       Int
  height      Int
  bytes       Int
  contentType String
  createdAt   DateTime @default(now())
  /// Last time an upload linked this asset (a fresh link keeps it from being deleted for a few minutes).
  linkedAt    DateTime @default(now())

  @@map("media_assets")
}
