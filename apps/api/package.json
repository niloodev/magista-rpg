{
  "name": "@magista/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "import:roll20": "tsx --env-file-if-exists=.env src/cli/importRoll20/importRoll20.ts",
    "account:password": "tsx --env-file-if-exists=.env src/cli/setPassword/setPassword.ts"
  },
  "dependencies": {
    "@magista/shared": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prisma": "^7.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
