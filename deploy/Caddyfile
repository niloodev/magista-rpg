{
	admin off
	auto_https disable_redirects
}

(magista) {
	log {
		output stdout
		format console
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}

	handle_path /api/* {
		reverse_proxy api:3333
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}

{$SITE_DOMAIN} {
	import magista
}

http://{$SITE_DOMAIN} {
	redir https://{host}{uri} permanent
}

http://:80 {
	import magista
}
